rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== helpers =====
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Admins exist ONLY as documents you create by hand in the Firebase console: admins/<your-uid>
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function optStr(v, max) { return v is string && v.size() <= max; }
    function phoneOk(v) { return v is string && v.matches('^[0-9+ ]{10,14}$'); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }

    // ===== admins: read-only for the admin themself, never writable from the app =====
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ===== audit log: only admins can append; nobody can edit or delete =====
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['by','action','target','detail','createdAt'])
        && request.resource.data.by == request.auth.uid
        && str(request.resource.data.action, 40) && str(request.resource.data.target, 80)
        && optStr(request.resource.data.detail, 200)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ===== users =====
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name','email','phone','role','createdAt'])
        && request.resource.data.keys().hasAll(['name','email','phone','role','createdAt'])
        && str(request.resource.data.name, 80)
        && request.resource.data.email == request.auth.token.email
        && phoneOk(request.resource.data.phone)
        && request.resource.data.role in ['customer','pandit']      // 'admin' is impossible from the app
        && request.resource.data.createdAt == request.time;
      // role and email can never change
      allow update: if isOwner(uid)
        && changed().hasOnly(['name','phone','city','address','lastBookingAt','updatedAt'])
        && str(request.resource.data.name, 80)
        && phoneOk(request.resource.data.phone)
        && optStr(request.resource.data.get('city',''), 60)
        && optStr(request.resource.data.get('address',''), 300)
        && (!changed().hasAny(['lastBookingAt']) || request.resource.data.lastBookingAt == request.time);
      allow delete: if false;

      // favourite pandits (private to the customer)
      match /favs/{pid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['panditId','name','createdAt'])
          && request.resource.data.panditId == pid
          && str(request.resource.data.name, 80)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }
    }

    // ===== pandits (public profile only once approved) =====
    function panditShape() {
      let d = request.resource.data;
      return str(d.name, 80) && str(d.city, 60)
        && d.languages is list && d.languages.size() > 0 && d.languages.size() <= 12
        && d.services is list && d.services.size() > 0 && d.services.size() <= 40
        && optStr(d.price, 80) && d.experience is number && d.experience >= 0 && d.experience <= 80
        && optStr(d.whatsapp, 14) && optStr(d.bio, 500)
        && (!('photoUrl' in d) || (d.photoUrl is string && d.photoUrl.size() <= 400 && (d.photoUrl == '' || d.photoUrl.matches('^https://[^ ]+$'))))
        && (!('unavailable' in d) || (d.unavailable is list && d.unavailable.size() <= 120));
    }
    match /pandits/{uid} {
      allow read: if resource.data.approved == true || isOwner(uid) || isAdmin();
      // a pandit can only create an UNAPPROVED profile, and only with a pandit account
      allow create: if isOwner(uid)
        && userDoc(uid).data.role == 'pandit'
        && request.resource.data.keys().hasOnly(['name','city','languages','services','price','experience','whatsapp','bio','photoUrl','unavailable','approved','createdAt'])
        && panditShape()
        && request.resource.data.approved == false
        && request.resource.data.createdAt == request.time;
      allow update:
        // owner edits: cannot touch approved/review fields; an approved pandit cannot rename themself
        if (isOwner(uid) && panditShape()
            && ((resource.data.approved == false
                  && changed().hasOnly(['name','city','languages','services','price','experience','whatsapp','bio','photoUrl','unavailable']))
             || (resource.data.approved == true
                  && changed().hasOnly(['city','languages','services','price','experience','whatsapp','bio','photoUrl','unavailable']))))
        // admin: approve / reject with a note, nothing else
        || (isAdmin() && changed().hasOnly(['approved','reviewNote','reviewedAt','rating','reviewCount'])
            && optStr(request.resource.data.get('reviewNote',''), 300)
            && (!('rating' in request.resource.data) || (request.resource.data.rating is number && request.resource.data.rating >= 0 && request.resource.data.rating <= 5))
            && (!('reviewCount' in request.resource.data) || (request.resource.data.reviewCount is int && request.resource.data.reviewCount >= 0)));
      allow delete: if false;
    }

    // ===== bookings =====
    function bookingFields() {
      let d = request.resource.data;
      return d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time.matches('^[0-9]{2}:[0-9]{2}$')
        && str(d.city, 60) && optStr(d.lang, 30) && str(d.address, 300)
        && optStr(d.get('notes',''), 500);
    }
    match /bookings/{id} {
      allow read: if isOwner(resource.data.customerId) || isOwner(resource.data.panditId) || isAdmin();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['customerId','customerName','customerPhone','puja','date','time','city','lang','address','notes','mode','samagri','panditId','panditName','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['customerId','customerName','customerPhone','puja','date','time','city','lang','address','mode','samagri','panditId','panditName','status','createdAt','updatedAt'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && str(request.resource.data.customerName, 80)
        && phoneOk(request.resource.data.customerPhone)
        && str(request.resource.data.puja, 80)
        && bookingFields()
        && request.resource.data.mode in ['home','online']
        && request.resource.data.samagri in ['pandit_only','with_samagri']
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        // anti-spam: max one booking per 30 seconds per user (the client updates users/<uid>.lastBookingAt in the same batch)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('lastBookingAt', null) == request.time
        && userDoc(request.auth.uid).data.get('lastBookingAt', timestamp.date(2000,1,1)) < request.time - duration.value(30, 's')
        // chosen pandit must be approved, name must match, and must be free on that date
        && ( (request.resource.data.panditId == '' && request.resource.data.panditName == '')
             || (get(/databases/$(database)/documents/pandits/$(request.resource.data.panditId)).data.approved == true
                 && get(/databases/$(database)/documents/pandits/$(request.resource.data.panditId)).data.name == request.resource.data.panditName
                 && !(request.resource.data.date in get(/databases/$(database)/documents/pandits/$(request.resource.data.panditId)).data.get('unavailable', []))) );

      allow update:
        // customer: edit details while still pending
        if (isOwner(resource.data.customerId) && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && changed().hasOnly(['date','time','city','lang','address','notes','updatedAt'])
            && bookingFields())
        // customer: cancel an open booking
        || (isOwner(resource.data.customerId)
            && changed().hasOnly(['status','updatedAt'])
            && resource.data.status in ['pending','accepted']
            && request.resource.data.status == 'cancelled')
        // pandit: move status along the allowed path, optional short note
        || (isOwner(resource.data.panditId)
            && changed().hasOnly(['status','updatedAt','panditNote'])
            && optStr(request.resource.data.get('panditNote',''), 200)
            && ((resource.data.status == 'pending' && request.resource.data.status in ['accepted','declined'])
                || (resource.data.status == 'accepted' && request.resource.data.status == 'completed')))
        // admin: assign pandit and correct status
        || (isAdmin() && changed().hasOnly(['panditId','panditName','status','updatedAt']));
      allow delete: if false;
    }

    // ===== reviews: only the customer of a COMPLETED booking, once, immutable =====
    match /reviews/{bid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['bookingId','panditId','customerId','customerName','rating','text','createdAt'])
        && request.resource.data.bookingId == bid
        && request.resource.data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(bid)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(bid)).data.status == 'completed'
        && get(/databases/$(database)/documents/bookings/$(bid)).data.panditId == request.resource.data.panditId
        && get(/databases/$(database)/documents/bookings/$(bid)).data.customerName == request.resource.data.customerName
        && request.resource.data.panditId != ''
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && optStr(request.resource.data.text, 300)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // everything else is closed
    match /{document=**} { allow read, write: if false; }
  }
}
