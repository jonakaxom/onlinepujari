rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Admins are created ONLY by hand in the Firebase console: collection "admins", document id = your uid.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function optStr(v, max) { return v is string && v.size() <= max; }
    function phoneOk(v) { return v is string && v.matches('^[0-9+ ]{10,14}$'); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------- admins: nobody can write from the app ----------
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // role can only be customer or pandit. 'admin' is impossible from the app.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name','email','phone','role','createdAt'])
        && request.resource.data.keys().hasAll(['name','email','phone','role','createdAt'])
        && str(request.resource.data.name, 80)
        && request.resource.data.email == request.auth.token.email
        && phoneOk(request.resource.data.phone)
        && request.resource.data.role in ['customer','pandit']
        && request.resource.data.createdAt == request.time;
      // role and email can never be changed
      allow update: if isOwner(uid)
        && changed().hasOnly(['name','phone','updatedAt'])
        && str(request.resource.data.name, 80)
        && phoneOk(request.resource.data.phone);
      allow delete: if false;
    }

    // ---------- pandits (public profile, only when approved) ----------
    function panditShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','city','languages','services','price','experience','whatsapp','bio','approved','createdAt'])
        && str(d.name, 80) && str(d.city, 60)
        && d.languages is list && d.languages.size() > 0 && d.languages.size() <= 12
        && d.services is list && d.services.size() > 0 && d.services.size() <= 40
        && optStr(d.price, 80) && d.experience is number && d.experience >= 0 && d.experience <= 80
        && optStr(d.whatsapp, 14) && optStr(d.bio, 500);
    }
    match /pandits/{uid} {
      allow read: if resource.data.approved == true || isOwner(uid) || isAdmin();
      // a pandit may only create an UNAPPROVED profile, and only if their account role is pandit
      allow create: if isOwner(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'pandit'
        && panditShape()
        && request.resource.data.approved == false
        && request.resource.data.createdAt == request.time;
      allow update: if
        (isOwner(uid) && panditShape()
          && request.resource.data.approved == resource.data.approved      // cannot self-approve
          && request.resource.data.createdAt == resource.data.createdAt)
        || (isAdmin() && changed().hasOnly(['approved']));
      allow delete: if false;
    }

    // ---------- bookings ----------
    match /bookings/{id} {
      allow read: if isOwner(resource.data.customerId) || isOwner(resource.data.panditId) || isAdmin();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['customerId','customerName','customerPhone','puja','date','time','city','lang','address','notes','panditId','panditName','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['customerId','customerName','customerPhone','puja','date','time','city','lang','address','panditId','panditName','status','createdAt','updatedAt'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && str(request.resource.data.customerName, 80)
        && phoneOk(request.resource.data.customerPhone)
        && str(request.resource.data.puja, 80)
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && str(request.resource.data.city, 60) && optStr(request.resource.data.lang, 30)
        && str(request.resource.data.address, 300)
        && (!('notes' in request.resource.data) || optStr(request.resource.data.notes, 500))
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && ( (request.resource.data.panditId == '' && request.resource.data.panditName == '')
             || (get(/databases/$(database)/documents/pandits/$(request.resource.data.panditId)).data.approved == true
                 && get(/databases/$(database)/documents/pandits/$(request.resource.data.panditId)).data.name == request.resource.data.panditName) );

      allow update:
        // customer: may only cancel their own open booking
        if (isOwner(resource.data.customerId)
            && changed().hasOnly(['status','updatedAt'])
            && resource.data.status in ['pending','accepted']
            && request.resource.data.status == 'cancelled')
        // pandit: may only move status along the allowed path
        || (isOwner(resource.data.panditId)
            && changed().hasOnly(['status','updatedAt'])
            && ((resource.data.status == 'pending' && request.resource.data.status in ['accepted','declined'])
                || (resource.data.status == 'accepted' && request.resource.data.status == 'completed')))
        // admin: assign pandit and fix status
        || (isAdmin() && changed().hasOnly(['panditId','panditName','status','updatedAt']));

      allow delete: if false;
    }

    // everything else is closed
    match /{document=**} { allow read, write: if false; }
  }
}
